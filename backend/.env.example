# ============================================================
# DDPRO BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# NEVER commit secrets, API keys, or credentials to git
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# SUPABASE CONFIGURATION (Phase 2+)
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Leave empty for Phase 1 development
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# DATABASE CONFIGURATION (Phase 2+)
# Format: postgresql://username:password@host:port/dbname
# ============================================================
DATABASE_URL=

# ============================================================
# JWT CONFIGURATION (Phase 2+)
# ============================================================
JWT_SECRET=
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ============================================================
# CORS CONFIGURATION
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,https://dogrudizaynpro.github.io

# ============================================================
# FEATURE FLAGS (Phase 1: All disabled)
# ============================================================
ENABLE_AUTH=false
ENABLE_DATABASE=false
ENABLE_RATE_LIMITING=false
ENABLE_REQUEST_LOGGING=true
