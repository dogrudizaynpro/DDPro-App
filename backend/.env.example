# ============================================================
# DDPRO BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# NEVER commit secrets, API keys, or credentials to git
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# SUPABASE CONFIGURATION (Phase 2+)
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Leave empty for Phase 1 development
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# AI PROVIDER (OpenAI-compatible Chat Completions endpoint)
# Keep credentials on the backend; never add these to VITE_* vars.
# ============================================================
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ============================================================
# WEB RESEARCH PROVIDER
# Endpoint contract: POST JSON { query }; responds { results: [...] }.
# Results are treated as unverified until a user checks the source.
# ============================================================
RESEARCH_API_URL=
RESEARCH_API_KEY=

# ============================================================
# GOOGLE / GMAIL / CALENDAR OAUTH
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_EMAILS=
FRONTEND_URL=http://localhost:5173
INTEGRATION_SESSION_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ============================================================
# WHATSAPP BUSINESS CLOUD API
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ============================================================
# WEBSITE LEAD WEBHOOK / CMS PROVIDER
# ============================================================
WEBSITE_WEBHOOK_SECRET=
WEBSITE_CMS_API_URL=
WEBSITE_CMS_API_TOKEN=

# ============================================================
# DATABASE CONFIGURATION (Phase 2+)
# Format: postgresql://username:password@host:port/dbname
# ============================================================
DATABASE_URL=

# ============================================================
# JWT CONFIGURATION (Phase 2+)
# ============================================================
JWT_SECRET=
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Production backend için GitHub Pages origin'ini ekli tutun.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,https://dogrudizaynpro.github.io

# ============================================================
# FEATURE FLAGS (Phase 1: All disabled)
# ============================================================
ENABLE_AUTH=false
ENABLE_DATABASE=false
ENABLE_RATE_LIMITING=false
ENABLE_REQUEST_LOGGING=true
