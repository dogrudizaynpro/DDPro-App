# ============================================================
# DDPRO BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# NEVER commit secrets, API keys, or credentials to git
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# SUPABASE CONFIGURATION (core data and integrations)
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# AI PROVIDER (OpenAI-compatible Chat Completions endpoint)
# Keep credentials on the backend; never add these to VITE_* vars.
# gpt-5.6-luna function tools require explicit reasoning_effort=none;
# omission uses provider defaults and can reject tools. DDPro sets this for that model.
# ============================================================
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ============================================================
# WEB RESEARCH PROVIDER
# Endpoint contract: POST JSON { query }; responds { results: [...] }.
# Results are treated as unverified until a user checks the source.
# ============================================================
RESEARCH_API_URL=
RESEARCH_API_KEY=

# ============================================================
# GOOGLE / GMAIL / CALENDAR OAUTH
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_EMAILS=
FRONTEND_URL=
# Generate both secrets with: openssl rand -hex 32
INTEGRATION_SESSION_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ============================================================
# WHATSAPP BUSINESS CLOUD API
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional server-managed JSON map: international digits-only phone -> allowed Google email.
# Keep empty for CRM-only inbound processing. Never bind customer numbers to staff accounts.
WHATSAPP_AI_ACCOUNTS=

# ============================================================
# WEBSITE LEAD WEBHOOK / CMS PROVIDER
# ============================================================
WEBSITE_WEBHOOK_SECRET=
WEBSITE_CMS_API_URL=
WEBSITE_CMS_API_TOKEN=

# ============================================================
# APP STORE CONNECT (server-side API access only)
# Store the App Store Connect .p8 key securely in the backend environment.
# ============================================================
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_ID=
APPLE_BUNDLE_ID=

# ============================================================
# DATABASE CONFIGURATION
# Used to run production database migrations before backend startup.
# Keep credentials in the backend secret manager; never expose this to VITE_*.
# Format: postgresql://username:password@host:port/dbname
# ============================================================
DATABASE_URL=
# Optional project CA PEM from Supabase Database Settings > SSL Configuration.
# Accepts multiline PEM or literal \n escapes. TLS and hostname checks stay enabled.
DATABASE_SSL_CA=
# Alternative: absolute path to a mounted CA PEM file (e.g. a Render Secret File).
# Set only one CA source. Omit both only when the database uses a publicly trusted CA.
DATABASE_SSL_CA_PATH=

# ============================================================
# JWT CONFIGURATION (Phase 2+)
# ============================================================
JWT_SECRET=
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Production ALLOWED_ORIGINS must contain only deployed frontend origins.
# Localhost origins are ignored by the backend when NODE_ENV=production.
ALLOWED_ORIGINS=

# ============================================================
# FEATURE FLAGS (Phase 1: All disabled)
# ============================================================
ENABLE_AUTH=false
ENABLE_DATABASE=false
ENABLE_RATE_LIMITING=false
ENABLE_REQUEST_LOGGING=true
